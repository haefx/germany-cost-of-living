# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=gcol
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gcol
POSTGRES_PORT=5432

# Used by the API container (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://gcol:change-me@postgres:5432/gcol

# --- API ---
# Random 32+ byte secret used to sign session-related values. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-a-random-32-byte-value
ENVIRONMENT=development
# Set to true only when served over HTTPS (production)
COOKIE_SECURE=false
# Only needed when web and API run on separate subdomains: set to their
# common parent domain (e.g. app.example.com when the API is
# api.app.example.com) so the session cookie is visible to both. Leave
# empty for localhost/Docker development.
COOKIE_DOMAIN=
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# How long an anonymous demo household is kept before automatic reset
DEMO_HOUSEHOLD_TTL_HOURS=24

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_PORT=3000
